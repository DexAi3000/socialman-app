generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                    String          @id @default(cuid())
  phone                 String          @unique
  username              String?         @unique
  password              String?
  fullName              String          @default("کاربر جدید")
  role                  String          @default("admin") // admin, creator, client
  plan                  String          @default("free") // free, pro, agency
  planStartedAt         DateTime?
  planExpiresAt         DateTime?
  avatarUrl             String?
  connectedAccountsData String?         // JSON string of Record<SocialPlatform, ConnectedAccountInfo>
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  workspaces            Workspace[]
  posts                 Post[]
  tickets               Ticket[]
  socialAccounts        SocialAccount[]
  notificationReads     NotificationRead[]
  customerDirects       CustomerDirect[]
}

model NotificationRead {
  userId String
  key    String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Workspace {
  id                    String    @id @default(cuid())
  name                  String
  category              String    @default("عمومی")
  connectedPlatforms    String    @default("[\"telegram\",\"instagram\"]") // JSON string array
  connectedAccountsData String?   // JSON string of Record<SocialPlatform, ConnectedAccountInfo>
  userId                String?
  user                  User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts                 Post[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Post {
  id                  String     @id @default(cuid())
  workspaceId         String
  workspace           Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title               String
  hook                String?
  content             String
  cta                 String?
  hashtags            String     @default("[]") // JSON string array
  platform            String     @default("instagram") // instagram, telegram, bale, rubika, whatsapp
  status              String     @default("draft") // draft, pending_approval, approved, published, rejected
  scheduledDateShamsi String?
  scheduledTime       String?
  mediaUrl            String?
  clientToken         String?
  clientFeedback      String?
  userId              String?
  user                User?      @relation(fields: [userId], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model SocialAccount {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String   // telegram, rubika, bale, instagram, whatsapp
  accountName String?
  handle      String?
  botToken    String?
  chatId      String?
  isConnected Boolean  @default(false)
  connectedAt String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ticket {
  id              String          @id @default(cuid())
  trackingCode    String          @unique
  subject         String
  department      String          @default("technical") // technical, billing, sales, ai
  priority        String          @default("medium") // low, medium, high, urgent
  status          String          @default("open") // open, in_progress, resolved, closed
  createdAtShamsi String
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  messages        TicketMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     String   // user, support, bot
  senderName String
  message    String
  timestamp  String
  createdAt  DateTime @default(now())
}

model CustomerDirect {
  id             String              @id @default(cuid())
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String              // telegram, instagram, whatsapp, bale, rubika
  customerName   String
  customerHandle String
  customerAvatar String?
  lastMessage    String
  lastMessageAt  DateTime            @default(now())
  isAiEnabled    Boolean             @default(true)
  unreadCount    Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  messages       DirectChatMessage[]
}

model DirectChatMessage {
  id         String         @id @default(cuid())
  directId   String
  direct     CustomerDirect @relation(fields: [directId], references: [id], onDelete: Cascade)
  sender     String         // customer, ai, admin
  senderName String
  text       String
  createdAt  DateTime       @default(now())
}

